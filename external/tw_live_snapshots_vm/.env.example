# tw_live_snapshots（HiCloud VM）：只寫 key 名稱，值不進 repo
# S3 正本（每日歸檔；同其他 VM app，可用 pulse-secret-run vm-env-sync 從既有 app 複製）
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
ARCHIVE_RETENTION_DAYS=7
# R2 最新快照（方案 A 才填；VM 目前沒有 R2 金鑰，vm-env-sync 白名單也不含，要站主決定）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET=
