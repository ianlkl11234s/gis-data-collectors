# fire119 VM 環境變數範本 — 部署位置 /opt/fire119/.env（chmod 600）
# 與其他 VM 收集器共用同一組 key：可從 /opt/waste-positions/ 複製過來再改下方路徑

# ─── Supabase（必填；與 ship_ais／waste_positions 同一條連線，不新增角色）───
SUPABASE_DB_URL=

# ─── S3 歸檔（必填）───
S3_BUCKET=migu-gis-data-collector
S3_REGION=ap-southeast-2
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── 路徑 ───
DATA_DIR=/var/lib/fire119/data
STATE_DIR=/var/lib/fire119/state
RAW_DIR=/var/lib/fire119/raw
GAZETTEER_PATH=/opt/fire119/road_gazetteer.sqlite

# ─── 保留與保護（可不動）───
ARCHIVE_RETENTION_DAYS=2
RAW_RETENTION_DAYS=3
MIN_MEM_AVAILABLE_MB=150
SOFT_DEADLINE_SEC=45
LAST_SEEN_FLUSH_MIN=30
# 暫停個別來源（逗號分隔，名稱見 fire119_parse.SOURCES），例：FIRE119_DISABLED=penghu,yilan
FIRE119_DISABLED=
