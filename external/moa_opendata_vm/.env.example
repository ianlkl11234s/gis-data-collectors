# /opt/moa-opendata/.env（chmod 600）。只列 key；值從既有 VM .env 或 Zeabur 複製，不要 commit。

# ─── Supabase（必填）───
# ⚠ SUPABASE_ENABLED=true 不能漏：false 時 collector 只寫本地 JSON、不寫 DB、不回報 collector_status
SUPABASE_ENABLED=true
SUPABASE_DB_URL=
# 一次性 process，不需要 Zeabur 的 2/15 連線池
SUPABASE_POOL_MIN=1
SUPABASE_POOL_MAX=2

# ─── S3 歸檔（必填，與 Zeabur／其他 VM app 同一組）───
S3_BUCKET=migu-gis-data-collector
S3_REGION=ap-southeast-2
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── 本地資料 ───
DATA_DIR=/var/lib/moa-opendata/data
# 本地 snapshot 保留天數；只有 S3 receipt 驗證過的日期目錄才會被刪
ARCHIVE_RETENTION_DAYS=7

# ─── 通知（選填；沒設就只寫 log）───
INSTANCE_NAME=hicloud-vm
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
