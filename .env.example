# Data Collectors 環境變數設定
# 複製此檔案為 .env 並填入實際值

# ============================================================
# TDX API（必填）
# 申請：https://tdx.transportdata.tw/
# ============================================================
TDX_APP_ID=your_tdx_app_id
TDX_APP_KEY=your_tdx_app_key

# ============================================================
# CWA 氣象局 API（選填）
# 申請：https://opendata.cwa.gov.tw/
# ============================================================
# CWA_API_KEY=your_cwa_api_key
CWA_MARINE_OBSERVATION_ENABLED=false
CWA_MARINE_OBSERVATION_INTERVAL=15
CWA_MARINE_OBSERVATION_ARCHIVE_RETENTION_DAYS=3
# ISOHE requires Taiwan egress. Keep Zeabur disabled; configure only on external/isohe_port_marine_vm.
ISOHE_PORT_MARINE_ENABLED=false
ISOHE_PORT_MARINE_INTERVAL=10
ISOHE_PORT_MARINE_ARCHIVE_RETENTION_DAYS=3

# ============================================================
# 臺灣網路健康（repo 預設關閉；production 自 2026-08-31 由 Zeabur env 啟用）
# Cloudflare Radar 與 IODA 是兩個獨立 evidence family，不能把同一來源的
# 多個 signal 當成多個獨立證據。缺值／過期只會成為 unknown，不補 0。
# Cloudflare 只有 fresh netflow + anomaly/outage 端點皆成功且無事件時，
# 才會寫單一 provider normal；跨來源 normal/degraded/outage detector 尚未實作。
# IODA alerts schema 未驗證，因此 IODA status 仍為 unknown；raw 僅內部收集。
# ============================================================
# CLOUDFLARE_RADAR_API_TOKEN=your_cloudflare_radar_token
CLOUDFLARE_RADAR_ENABLED=false
CLOUDFLARE_RADAR_INTERVAL=5
CLOUDFLARE_RADAR_ARCHIVE_RETENTION_DAYS=3
IODA_INTERNET_HEALTH_ENABLED=false
IODA_INTERNET_HEALTH_INTERVAL=5
IODA_INTERNET_HEALTH_ARCHIVE_RETENTION_DAYS=3
INTERNET_HEALTH_LOCATION=TW
INTERNET_HEALTH_LOOKBACK_MINUTES=180
CLOUDFLARE_RADAR_STALE_AFTER_SECONDS=2700
IODA_STALE_AFTER_SECONDS=3600
# IODA /v2/outages/alerts 尚未驗證 response schema，保持 false。
IODA_ALERTS_ENABLED=false

# ============================================================
# YouTube Data API v3（yt_live_video_resolver 必填，選填 collector）
# GCP Console 啟用 YouTube Data API v3 → 建 API key（建議限制只給該 service）
# 配額：search.list 獨立桶 100 calls/day/專案；其餘端點共用 10,000 units/day，PT 午夜重置
# ============================================================
# YOUTUBE_API_KEY=your_youtube_data_api_v3_key
# YT_LIVE_VIDEO_RESOLVER_ENABLED=true
# YT_LIVE_VIDEO_RESOLVER_INTERVAL=5

# ============================================================
# 環境部 MOENV API（空氣品質，選填）
# 公開 key 可直接使用，專屬申請：https://data.moenv.gov.tw/
# ============================================================
# MOENV_API_KEY=your_moenv_api_key

# 空氣品質系列 collector 預設為 false（多實例部署：只在一個實例打開即可）
# 空氣品質 - airtw 全台色階圖 PNG（無需 API key，每小時）
# AIR_QUALITY_IMAGERY_ENABLED=true
# AIR_QUALITY_IMAGERY_INTERVAL=60
# AIR_QUALITY_IMAGERY_PRODUCTS=AQI,PM25,PM10,O3,NO2

# 空氣品質 - 環境部 77 站即時觀測（需 MOENV_API_KEY，每小時）
# AIR_QUALITY_ENABLED=true
# AIR_QUALITY_INTERVAL=60

# 空氣品質 - LASS AirBox 微型感測器（無需 API key，每 5 分鐘）
# AIR_QUALITY_MICROSENSORS_ENABLED=true
# AIR_QUALITY_MICROSENSORS_INTERVAL=5
# AIR_QUALITY_MICROSENSORS_PM25_OUTLIER=500

# ============================================================
# 收集器設定
# ============================================================
# YouBike 城市（逗號分隔）
YOUBIKE_CITIES=Taipei,NewTaipei,Taoyuan

# YouBike 收集間隔（分鐘）
YOUBIKE_INTERVAL=15

# 氣象站收集間隔（分鐘）
# WEATHER_INTERVAL=60

# 地震報告 + 逐站觀測 + 海嘯資訊（需要 CWA API Key）
# 2026-07 起 15 分鐘（事件驅動，每日一次會慢一天才進庫）
EARTHQUAKE_ENABLED=true
# EARTHQUAKE_INTERVAL=15

# 完整地震目錄 E-A0073-001（含無感，半年更新一批；需 CWA API Key）
# 每日抓一次跟 DB 比對，沒有新資料就不寫
# EARTHQUAKE_CATALOG_ENABLED=false
# EARTHQUAKE_CATALOG_INTERVAL=1440

# 鄉鎮震度 E-A0015-005（S3 直抓免金鑰，368 鄉鎮/次；上游只留最新一次地震）
# EARTHQUAKE_TOWN_INTENSITY_ENABLED=false
# EARTHQUAKE_TOWN_INTENSITY_INTERVAL=15

# 地震網格 shakemap（NCDR EQ1 免金鑰，全台 2.5km 共 4,377 格；上游只留最新一次地震）
# EARTHQUAKE_SHAKEMAP_GRID_ENABLED=false
# EARTHQUAKE_SHAKEMAP_GRID_INTERVAL=15

# 震源機制解（中研院 AutoBATS；用 CWA 事件清單逐一查，需 CWA API Key）
# EARTHQUAKE_MOMENT_TENSOR_ENABLED=false
# EARTHQUAKE_MOMENT_TENSOR_INTERVAL=30

# 農業部待認領養動物完整快照（預設關閉；啟用前需先套用 gis-platform migration）
# 僅完整成功名單會更新 current/daily；每份 raw JSON 由既有 archive 任務上傳 S3。
# ANIMAL_ADOPTION_ENABLED=true
# ANIMAL_ADOPTION_INTERVAL=1440
# ANIMAL_ADOPTION_MIN_ROWS=1000
# ANIMAL_ADOPTION_HTTP_RETRIES=3

# 農業部收容成果／壓力歷史月報（預設關閉；兩個 source job 各自獨立）
# 官方月報整批回傳歷史資料；完整 root array 才寫入，raw JSON 由既有 archive 任務上傳 S3。
# ANIMAL_SHELTER_OUTCOMES_ENABLED=true
# ANIMAL_SHELTER_OUTCOMES_INTERVAL=43200
# ANIMAL_SHELTER_OUTCOMES_MIN_ROWS=3000
# ANIMAL_SHELTER_PRESSURE_ENABLED=true
# ANIMAL_SHELTER_PRESSURE_INTERVAL=43200
# ANIMAL_SHELTER_PRESSURE_MIN_ROWS=1800
# ANIMAL_SHELTER_HTTP_RETRIES=3
# 動物福利服務據點（預設停用；勿在 Zeabur 未驗收前啟用）
# ANIMAL_VETERINARY_CLINICS_ENABLED=false
# ANIMAL_VETERINARY_CLINICS_INTERVAL=259200
# ANIMAL_VETERINARY_CLINICS_MIN_ROWS=1800
# ANIMAL_LICENSED_PET_BUSINESSES_ENABLED=false
# ANIMAL_LICENSED_PET_BUSINESSES_INTERVAL=525600
# ANIMAL_LICENSED_PET_BUSINESSES_MIN_ROWS=5000
# ANIMAL_PROTECTION_OFFICES_ENABLED=false
# ANIMAL_PROTECTION_OFFICES_INTERVAL=129600
# ANIMAL_PROTECTION_OFFICES_MIN_ROWS=22
# ANIMAL_WELFARE_POINTS_HTTP_RETRIES=3

# VD 車輛偵測器城市（逗號分隔）
VD_CITIES=Taipei,NewTaipei

# VD 收集間隔（分鐘）
VD_INTERVAL=5

# ============================================================
# 公車即時位置（TDX Bus/RealTimeByFrequency）
# 預設涵蓋全台 22 縣市：
#   直轄市 (6): Taipei, NewTaipei, Taoyuan, Taichung, Tainan, Kaohsiung
#   省轄市 (3): Keelung, Hsinchu, Chiayi
#   縣 (10):   HsinchuCounty, MiaoliCounty, ChanghuaCounty, NantouCounty,
#              YunlinCounty, ChiayiCounty, PingtungCounty, YilanCounty,
#              HualienCounty, TaitungCounty
#   離島 (3):  PenghuCounty, KinmenCounty, LienchiangCounty
# ============================================================
# BUS_ENABLED=true
# 留空使用預設的 22 縣市，或自訂清單（逗號分隔）
# BUS_CITIES=Taipei,NewTaipei,Taoyuan,Taichung,Tainan,Kaohsiung
# 全台 22 縣市 × 每 2 分鐘 = 15,840 req/日（超過 TDX 免費 10k 配額）
#   - 免費 key：調高至 BUS_INTERVAL=3 或縮減城市
#   - 付費 key（1M/日）：預設 2 分鐘即可
# BUS_INTERVAL=2
# collector 內部並行抓城市的 worker 數（避免超過 TDX rate limit）
# BUS_FETCH_WORKERS=5

# 公路客運 / 國道客運（TDX Bus/RealTimeByFrequency/InterCity，單一 endpoint）
# BUS_INTERCITY_ENABLED=false
# BUS_INTERCITY_INTERVAL=2

# 溫度網格收集間隔（分鐘）
TEMPERATURE_INTERVAL=60

# 路邊停車城市（逗號分隔）
# 支援：Taipei, NewTaipei, Taichung（高雄不支援）
PARKING_CITIES=Taipei,NewTaipei,Taichung

# 路邊停車收集間隔（分鐘）
PARKING_INTERVAL=15

# 台鐵即時列車收集間隔（分鐘）
TRA_TRAIN_INTERVAL=2

# 台鐵靜態資料收集間隔（分鐘，1440=每日一次）
TRA_STATIC_INTERVAL=1440

# 台鐵 + 高鐵每日時刻表歸檔（DailyTimetable，含停駛/加班車）
# TDX 歷史只保留 ~90 天，每日歸檔才有長期資料
RAIL_TIMETABLE_ENABLED=true
# RAIL_TIMETABLE_INTERVAL=1440

# 航運 - TDX 國內航線船位（每 2 分鐘）
SHIP_TDX_ENABLED=true
SHIP_TDX_INTERVAL=2

# 航運 - 航港局 AIS 全船型追蹤（每 2 分鐘）
SHIP_AIS_ENABLED=true
SHIP_AIS_INTERVAL=2

# OpenSky 台灣空域快照（每 5 分鐘）
# 匿名可用，帶帳號可提升至 5 秒解析度 + 4,000 credits/天
# 申請：https://opensky-network.org/
# FR24 Zone 空域快照（公開 feed，無需 API key，每 5 分鐘）
FLIGHT_FR24_ZONE_ENABLED=false
# FLIGHT_FR24_ZONE_INTERVAL=5
# bbox 可個別調整（FR24 免費，可比 OpenSky 範圍大）
# FLIGHT_FR24_ZONE_LAMIN=21
# FLIGHT_FR24_ZONE_LAMAX=27
# FLIGHT_FR24_ZONE_LOMIN=117
# FLIGHT_FR24_ZONE_LOMAX=123

# OpenSky 台灣空域快照（每 5 分鐘）
FLIGHT_OPENSKY_ENABLED=false
# FLIGHT_OPENSKY_INTERVAL=5
# OAuth2 認證（新帳號，從 Account 頁面取得 API Client）
# FLIGHT_OPENSKY_CLIENT_ID=your-api-client
# FLIGHT_OPENSKY_CLIENT_SECRET=your_client_secret
# Basic Auth（舊帳號，二擇一即可）
# FLIGHT_OPENSKY_USERNAME=your_opensky_username
# FLIGHT_OPENSKY_PASSWORD=your_opensky_password

# 衛星軌道追蹤（Space-Track.org GP + SGP4，需免費帳號，每 2 小時）
# 註冊 https://www.space-track.org/ 後填入帳密
# 活躍衛星寫入 satellite_current / satellite_positions，完整 TLE（含失效）寫入 satellite_tle
SATELLITE_ENABLED=false
# SATELLITE_INTERVAL=120
# SPACETRACK_USERNAME=your_email@example.com
# SPACETRACK_PASSWORD=your_password

# ============================================================
# 水文系列（WRA 水利署 + CWA，大多無需 API key；預設 false）
# ============================================================
# 水庫水情（WRA OpenData，每 60 分鐘）
# WATER_RESERVOIR_ENABLED=true
# WATER_RESERVOIR_INTERVAL=60

# 河川即時水位（WRA OpenData UUID 73c4c3de-...，每 10 分鐘）
# RIVER_WATER_LEVEL_ENABLED=true
# RIVER_WATER_LEVEL_INTERVAL=10

# CWA 即時雨量站 O-A0002-001（需 CWA_API_KEY，每 10 分鐘）
# RAIN_GAUGE_REALTIME_ENABLED=true
# RAIN_GAUGE_REALTIME_INTERVAL=10

# 健保署重度級急救責任醫院急診即時量能（NHI info.nhi.gov.tw，免金鑰，來源每 15 分更新，約 59 家醫院）
# ER_HOSPITAL_REALTIME_ENABLED=true
# ER_HOSPITAL_REALTIME_INTERVAL=15

# 地下水水位（WRA OpenData UUID 58a7aa39-...，每 60 分鐘，779 口觀測井）
# GROUNDWATER_LEVEL_ENABLED=true
# GROUNDWATER_LEVEL_INTERVAL=60

# 水庫每日營運狀況（WRA OpenData 41568，每日一次，官方 09:30 前更新）
# WATER_RESERVOIR_DAILY_OPS_ENABLED=true
# WATER_RESERVOIR_DAILY_OPS_INTERVAL=1440

# 水情燈號 daily（wra.gov.tw HTML scrape，上游不定期；hash 比對去重）
# WRA_DROUGHT_ALERT_ENABLED=true
# WRA_DROUGHT_ALERT_INTERVAL=1440

# 水利署 IoT 7 類站點整合（河川/地下水/閘門/沖刷/流量/堤防/揚塵）
# IOT_WRA_ENABLED=true
# IOT_WRA_INTERVAL=60

# 都市淹水感知器 USWG（OAuth2，1999 站全國淹水深度即時，rain-impact 用）
# 需先到 https://iot.wra.gov.tw/ 註冊取得 API 認證 ID/密碼
# IOW_CLIENT_ID=
# IOW_CLIENT_SECRET=
# USWG_ENABLED=false   # 預設關閉，雲端設 true 才啟用
# USWG_INTERVAL=10

# 累積雨量柵格圖（共用 IOW_CLIENT_*；每小時抓 ch=1/3/6/24 四張 PNG ~67KB total）
# PRECIPITATION_RASTER_ENABLED=false
# PRECIPITATION_RASTER_INTERVAL=60
# PRECIPITATION_RASTER_CH_LIST=1,3,6,24   # 自訂累積時長清單

# ============================================================
# 環境衛生 — 垃圾車即時 GPS（高雄/新北/台南，無 API key）
# ============================================================
# 三家公開資料平台：高雄 openapi.kcg / 新北 data.ntpc / 台南 soa.tainan
# 平日午班/晚班尖峰 ~600 筆/輪；台北市無公開 GPS API
# WASTE_POSITIONS_ENABLED=true
# WASTE_POSITIONS_INTERVAL=2
# WASTE_POSITIONS_CITIES=Kaohsiung,NewTaipei,Tainan
# 凌晨零信號跳過（HH-HH 前閉後開；'none' 關閉；可跨午夜如 '22-06'）
# WASTE_POSITIONS_QUIET_HOURS=01-06

# 垃圾車 OSRM map-matching（需先部署 OSRM Taiwan service + migration 074）
# WASTE_MATCH_ENABLED=true
# WASTE_MATCH_INTERVAL=5
# OSRM_URL=http://localhost:5000
# 若 OSRM 走跨 project 的 osrm-proxy (Bearer token gateway)，需帶 token；同 project 內網直連可空
# OSRM_TOKEN=
# WASTE_MATCH_CITIES=高雄市
# WASTE_MATCH_TARGET_DAYS=2
# WASTE_MATCH_MAX_TRIPS=80
# WASTE_MATCH_MAX_POINTS=100
# WASTE_MATCH_RADIUS_M=50
# WASTE_MATCH_MIN_CONFIDENCE=0.35

# ============================================================
# Foursquare OS Places POI（HuggingFace gated dataset，每月全量）
# ============================================================
# 需先至 https://huggingface.co/settings/tokens 申請 token
# 並接受 dataset 使用條款：https://huggingface.co/datasets/foursquare/fsq-os-places
# FOURSQUARE_POI_ENABLED=true
# FOURSQUARE_POI_INTERVAL=43200
# HF_TOKEN=hf_your_huggingface_token
# 指定特定 release（選填，留空用最新）
# FOURSQUARE_POI_RELEASE_DT=2026-03-18

# ============================================================
# S3 儲存（建議生產環境設定）
# ============================================================
# S3_BUCKET=your-bucket-name
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
# S3_REGION=ap-northeast-1

# MinIO 或其他 S3 相容服務
# S3_ENDPOINT=https://minio.example.com

# ============================================================
# Global Fishing Watch unified hourly release（預設雙閘門關閉）
# ============================================================
# GFW_ACCESS_TOKEN=your_backend_only_token
# 舊 DAILY presence collector 不可與 unified hourly job 同時開啟。
# GFW_VESSEL_PRESENCE_ENABLED=false
# GFW_HOURLY_PUBLISH_ENABLED=false
# 僅在已審核 GFW redistribution/attribution 後才能改 true。
# GFW_HOURLY_REDISTRIBUTION_APPROVED=false
# 固定每日排程，容器 TZ=Asia/Taipei；08:30 在 UTC 換日後，避免手動 post-08:00
# release 被隔日舊窗口重複發布；deploy 時不會立即執行。
# GFW_HOURLY_PUBLISH_TIME=08:30
# GFW_DATA_LAG_DAYS=5
# GFW_HOURLY_BBOX=122.43400,23.22953,132.85274,34.35812
# GFW_HOURLY_ROLLING_DAYS=7
# GFW_HOURLY_TILE_SIZE_DEGREES=3
# 變更 bbox/tile size 時必須一起明確調整，防止靜默放大 reports。
# GFW_HOURLY_EXPECTED_TILE_COUNT=16
# GFW_HOURLY_TRACK_GAP_HOURS=2
# GFW_HOURLY_MAX_SPEED_KNOTS=80
# 固定 2（current + previous）；其他值會 fail closed。
# GFW_HOURLY_RELEASES_TO_KEEP=2
# GFW_HOURLY_FAILED_SPOOL_RETENTION_DAYS=7
# GFW_HOURLY_S3_PREFIX=deploy-assets/global-maritime/gfw-hourly
# 必須是 Cloudflare 對外 origin path，且對應上述 S3 prefix 去掉 deploy-assets/。
# GFW_HOURLY_PUBLIC_URL_PREFIX=https://<cloudflare-domain>/global-maritime/gfw-hourly
# v3 驗收期使用固定 nested shadow root；不可覆寫 canonical v2 root。
# GFW_HOURLY_SHADOW_S3_PREFIX=deploy-assets/global-maritime/gfw-hourly/v3-shadow
# GFW_HOURLY_SHADOW_PUBLIC_URL_PREFIX=https://<cloudflare-domain>/global-maritime/gfw-hourly/v3-shadow

# S3 費用估算（日報使用；bucket 若有 Lifecycle 分層會按 class 分別計算）
# 保留介面，預設為 Standard 單價（ap-southeast-2 2026 定價，USD/GB/月）
# S3_PRICE_PER_GB=0.025
# 以下為各 storage class 的單價 overrides（有預設值，通常不需設定）
# S3_PRICE_STANDARD=0.025
# S3_PRICE_STANDARD_IA=0.0138
# S3_PRICE_GLACIER_IR=0.005
# S3_PRICE_GLACIER=0.0045
# S3_PRICE_DEEP_ARCHIVE=0.002

# ============================================================
# Supabase → S3 備份系統（tasks/backup_supabase.py）
# ============================================================
# 啟用後每日 03:30 UTC 將 Supabase 各表快照備份至 S3
# BACKUP_ENABLED=false
# 僅印出計畫，不實際上傳（測試用）
# BACKUP_DRY_RUN=false
# static/reference 表使用的 S3 StorageClass（預設 GLACIER_IR，低頻讀取省費）
# BACKUP_STATIC_STORAGE_CLASS=GLACIER_IR
# realtime 分區表使用的 StorageClass（預設 STANDARD）
# BACKUP_REALTIME_STORAGE_CLASS=STANDARD
# 每個 COPY 查詢的 statement_timeout（毫秒，預設 5 分鐘）
# BACKUP_STATEMENT_TIMEOUT_MS=300000

# ============================================================
# 通知設定（選填）
# ============================================================
# Webhook（支援 Discord、Slack 等）
# WEBHOOK_URL=https://discord.com/api/webhooks/xxx

# LINE Notify
# LINE_TOKEN=your_line_notify_token

# Telegram Bot（每日報告 + 即時錯誤通知）
# 1. 在 Telegram 找 @BotFather 建立 Bot，取得 Token
# 2. 傳訊息給你的 Bot，然後用 https://api.telegram.org/bot<TOKEN>/getUpdates 取得 Chat ID
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHAT_ID=123456789

# 每日報告時間（預設 08:00）
# DAILY_REPORT_TIME=08:00

# 連續錯誤告警門檻（預設 3 次）
# CONSECUTIVE_ERROR_THRESHOLD=3

# 磁碟空間告警門檻（MB，預設 8000）
# DISK_ALERT_THRESHOLD_MB=8000

# ============================================================
# HTTP API（下載資料用）
# ============================================================
# API Key（必填才會啟動 API Server）
# 建議使用隨機字串，例如：openssl rand -hex 32
API_KEY=your_api_key_here

# API 端口（預設 8080）
# API_PORT=8080

# ============================================================
# 其他
# ============================================================
# 實例名稱（多實例部署時辨識來源，例如「主站」、「AIS專機」）
# INSTANCE_NAME=主站

# DEBUG=true
# LOG_LEVEL=DEBUG
