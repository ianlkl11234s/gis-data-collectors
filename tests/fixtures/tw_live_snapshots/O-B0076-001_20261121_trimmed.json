{"cwaopendata": {"@xmlns": "urn:cwa:gov:tw:cwacommon:0.1", "Identifier": "302d4a34-8bb8-41d3-8dd3-63bb3f004aec", "DatasetID": "O-MMC-0001", "DatasetName": "即時海況觀測", "DataItemID": "O-MMC-0001-00004", "Sender": "od@cwa.gov.tw", "Sent": "2026-11-21T16:06:03+08:00", "Status": "Actual", "Scope": "Public", "MsgType": "Issue", "Resources": {"Resource": {"Metadata": {"ResourceID": "O-MMC-0001-00004", "ResourceName": "中央氣象署海象觀測_浮標站與潮位站測站資料", "ResourceDescription": "中央氣象署所屬本島各站之潮位資料皆根據內政部國土測繪中心所公告之一等水準點以及潮位站參考水準點高程值引測至臺灣高程基準(TWVD2001)，即以基隆平均海水面當作零點。離島潮位站(例如:澎湖、金門、馬祖、蘭嶼、綠島等)或是海上觀測樁通常引測至當地平均海水面當作零點，並未聯測回臺灣本島。全臺各地之即時海象觀測資料，內容包含潮位站、資料浮標站、波浪站等觀測站，觀測項目包含潮位、海溫、波浪、風、氣壓、海流等等氣象元素。stationStatus與obsStatus為空值表示無資料回傳，0表示 無觀測，1表示 傳送，2表示 停送。", "Language": "zh", "Sources": {"Source": [{"Title": "即時海況所屬觀測站說明", "Path": "https://opendata.cwa.gov.tw/dataset/forecast/O-B0076-001", "Description": "請到中央氣象署氣象資料開放平臺提供的連結取得所需說明資料"}, {"Title": "Abbreviation for unit of measure - as defined within WMO No. 306 Common code-table C-6 1List of units for TDCFs1. (use wmo abbreviation)", "Path": "http://codes.wmo.int/common/unit"}]}, "Temporal": {"Description": "即時海況觀測狀態 / 更新頻率為每天", "Update": "2026-11-21T16:06:03+08:00"}, "Spatial": {"CoordinateReferenceSystem": {"EPSGCode": "EPSG:4326", "CoordinateName": "WGS84", "CoordinateDatum": "World Geodetic System 1984(EPSG:6326)", "CoordinateFormat": "decimal degrees"}}}, "Data": {"SeaSurfaceObs": {"Location": [{"Station": {"StationID": "46761F", "StationName": "成功浮球式波浪站", "StationAttribute": "浮球站", "StationLongitude": "121.4201", "StationLatitude": "23.1325", "County": {"CountyName": "臺東縣", "CountyNameEN": "Taitung County"}, "Town": {"TownName": "成功鎮", "TownNameEN": "Chenggong Township"}}, "Description": null, "Sequence": "0", "StationObsStatus": {"StationStatus": "1"}}, {"Station": {"StationID": "C4A06", "StationName": "淡海潮位站", "StationAttribute": "潮位站", "StationLongitude": "121.4075", "StationLatitude": "25.1839", "County": {"CountyName": "新北市", "CountyNameEN": "Ne